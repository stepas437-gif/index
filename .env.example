NODE_ENV=production
PORT=3000
BASE_URL=https://your-domain.example
COOKIE_SECURE=true
ALLOW_MAIL_PREVIEW=false

# Keep mutable data outside the code checkout on the VPS.
DATA_DIR=/var/lib/chupep
DB_PATH=/var/lib/chupep/music.db
UPLOAD_DIR=/var/lib/chupep/uploads

# SMTP for account emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASS=your-password
SMTP_FROM="CHUPEP <mailer@example.com>"

# Streamer account
STREAMER_EMAIL=your-real-email@example.com
STREAMER_PASSWORD=replace-with-a-long-random-password
STREAMER_NAME=Главный стример
